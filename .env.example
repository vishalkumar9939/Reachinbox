# ==============================================================================
# ReachInbox Email Scheduler - Environment Configuration
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000

# Authentication & JWT
JWT_SECRET=reachinbox_super_secret_jwt_key_change_in_production_2025
JWT_EXPIRES_IN=7d

# Database (PostgreSQL / Prisma)
DATABASE_URL=postgresql://reachinbox:reachinbox123@localhost:5432/reachinbox_db?schema=public

# Redis & BullMQ
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Worker & Rate Limiting Settings
WORKER_CONCURRENCY=5
MAX_EMAILS_PER_HOUR=200
MIN_EMAIL_DELAY_MS=2000

# Nodemailer / Ethereal Email SMTP
# If left blank, backend will automatically generate dynamic Ethereal test accounts on startup!
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
DEFAULT_SENDER_EMAIL=outreach@reachinbox.ai
DEFAULT_SENDER_NAME=ReachInbox Outreach

# Google OAuth 2.0
# Obtain from Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Slack OAuth Integration
# Obtain from api.slack.com -> Your App -> OAuth & Permissions
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:5000/api/slack/callback

# Elasticsearch (Optional - System will gracefully fallback to Database search if ES is unavailable)
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=reachinbox-emails
